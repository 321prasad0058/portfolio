{
  "name": "prasad-alai-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prasad Anil Alai — a scroll-driven 3D story of a software engineer, built with Three.js and GSAP",
  "scripts": {
    "dev": "vite --host",
    "activity": "node scripts/fetch-activity.mjs",
    "build": "node scripts/fetch-activity.mjs --soft && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  },
  "engines": { "node": ">=20" }
}
